# Copy to .env.local for local dev. In Vercel, set these under Project → Settings → Environment Variables.
# Never commit real values.

# ── Site ───────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used for Stripe redirect URLs, sitemap, OG tags and email links.
# On Vercel, falls back to VERCEL_PROJECT_PRODUCTION_URL if unset — set it explicitly once you have a domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Printful ───────────────────────────────────────────────────────────────────
# Private token: https://developers.printful.com/tokens  (scopes: orders, sync products, webhooks, stores list)
PRINTFUL_API_TOKEN=
# Required only if the token can access more than one store. Find it in Printful → Settings → Stores.
PRINTFUL_STORE_ID=
# "false" = create Printful orders as DRAFTS for manual review (recommended until you trust the flow).
# "true"  = submit orders for fulfilment immediately (Printful starts charging you).
PRINTFUL_AUTO_CONFIRM=false
# Random string (≥32 chars). Printful v1 webhooks are unsigned, so this goes in the webhook URL:
#   https://yourdomain.com/api/webhooks/printful?secret=<this value>
# Generate: openssl rand -hex 32
PRINTFUL_WEBHOOK_SECRET=

# ── Stripe ─────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys — use sk_test_… locally and in Preview, sk_live_… in Production.
STRIPE_SECRET_KEY=
# Signing secret for /api/webhooks/stripe.
#   Local:      printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#   Production: Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# ── Resend ─────────────────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
# Sender. The domain must be verified in Resend, e.g. "Brand Name <orders@yourdomain.com>".
EMAIL_FROM=
# Where order-failed / order-canceled alerts go.
ADMIN_ALERT_EMAIL=

# ── Cache ──────────────────────────────────────────────────────────────────────
# Shared secret for POST /api/revalidate (refreshes the catalog right away instead of waiting the 1-hour ISR window).
# Generate: openssl rand -hex 32
REVALIDATE_SECRET=
